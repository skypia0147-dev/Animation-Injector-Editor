<?xml version="1.0" encoding="utf-8"?>
<AnimationSet version="4" id="EditFuzzSelecting">
  <EventRegistry>
    <Event name="SoundPlay.WPNBowPullLPM"/>
    <Event name="SoundStop.WPNBowPullLPM"/>
    <Event name="SoundPlay.WPNBowFire"/>
    <Event name="DodgeShotFire">
      <Do op="fireArrow"/>
    </Event>
  </EventRegistry>
  <Action id="Pick0">
    <Start key="Mouse2"/>
    <Require cooldown="0.2"/>
    <Suppress events="blockStart,bashStart"/>
    <Flow entry="RequireWeapon">
      <Test id="RequireWeapon" kind="weaponDrawn" subject="self" pass="bow"/>
      <Test id="bow" kind="equippedType" subject="self" hand="left" type="bow" pass="drawn"/>
      <Any id="drawn" pass="sneak">
        <Use node="attached"/>
        <Use node="pulled"/>
      </Any>
      <Test id="attached" kind="attackState" subject="self" state="bowAttached"/>
      <Test id="pulled" kind="attackState" subject="self" state="bowDrawn"/>
      <Test id="sneak" kind="sneaking" subject="self" pass="direction_a2_B1"/>
      <Test id="direction_a2_B1" kind="movementDirection" subject="self" option="back" pass="Destination1" fail="direction_a2_L1"/>
      <Play id="Destination1" action="Dodge4"/>
      <Test id="direction_a2_L1" kind="movementDirection" subject="self" option="left" pass="Destination2" fail="direction_a2_R1"/>
      <Play id="Destination2" action="Dodge5"/>
      <Test id="direction_a2_R1" kind="movementDirection" subject="self" option="right" pass="Destination3"/>
      <Play id="Destination3" action="Dodge6"/>
    </Flow>
  </Action>
  <Action id="Dodge1" clip="animationsEditFuzz${id}_A1.hkx" firstPerson="switch">
    <Require cooldown="0.2"/>
    <Exit blend="0.3"/>
    <IFrame until="0.8"/>
    <Recovery at="1.647" blend="0.35"/>
    <EventValues>
      <Event name="DodgeShotFire">
        <Do op="fireArrow" mode="direct" damage="50"/>
      </Event>
    </EventValues>
  </Action>
  <Action id="Dodge2" clip="animationsEditFuzz${id}_A1.hkx" firstPerson="switch">
    <Require cooldown="0.2"/>
    <Exit blend="0.3"/>
    <IFrame until="0.8"/>
    <Recovery at="1.397" blend="0.35"/>
    <FireArrow/>
  </Action>
  <Action id="Dodge3" clip="animationsEditFuzz${id}_A1.hkx" firstPerson="switch">
    <Require cooldown="0.2"/>
    <Exit blend="0.3"/>
    <IFrame until="0.8"/>
    <Recovery at="1.647" blend="0.35"/>
    <FireArrow/>
  </Action>
  <Action id="Dodge4" clip="animationsEditFuzz${id}_A1.hkx" firstPerson="switch">
    <Require cooldown="0.2"/>
    <Exit blend="0.3"/>
    <IFrame until="0.8"/>
    <Recovery at="1.647" blend="0.35"/>
    <FireArrow/>
  </Action>
  <Action id="Dodge5" clip="animationsEditFuzz${id}_A1.hkx" firstPerson="switch">
    <Require cooldown="0.2"/>
    <Exit blend="0.3"/>
    <IFrame until="0.8"/>
    <Recovery at="1.397" blend="0.35"/>
    <FireArrow/>
  </Action>
  <Action id="Dodge6" clip="animationsEditFuzz${id}_A1.hkx" firstPerson="switch">
    <Require cooldown="0.2"/>
    <Exit blend="0.3"/>
    <IFrame until="0.8"/>
    <Recovery at="1.647" blend="0.35"/>
    <FireArrow/>
  </Action>
  <Action id="Pick7">
    <Start key="E"/>
    <Flow entry="direction_a1_B1">
      <Test id="direction_a1_B1" kind="movementDirection" subject="self" option="back" pass="Destination1" fail="direction_a1_L1"/>
      <Play id="Destination1" action="Dodge1"/>
      <Test id="direction_a1_L1" kind="movementDirection" subject="self" option="left" pass="Destination2" fail="direction_a1_R1"/>
      <Play id="Destination2" action="Dodge2"/>
      <Test id="direction_a1_R1" kind="movementDirection" subject="self" option="right" pass="Destination3"/>
      <Play id="Destination3" action="Dodge3"/>
