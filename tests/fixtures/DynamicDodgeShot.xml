<?xml version="1.0" encoding="utf-8"?>
<AnimationSet version="6" id="DynamicDodgeShot">
  <EventRegistry>
    <Event name="SoundPlay.WPNBowPullLPM"/>
    <Event name="SoundStop.WPNBowPullLPM"/>
    <Event name="SoundPlay.WPNBowFire"/>
    <Event name="DodgeShotFire">
      <Do op="fireArrow"/>
    </Event>
  </EventRegistry>
  <Start id="BowDodge" key="Mouse2" cooldown="0.2" block="blockStart,bashStart">
    <Check kind="weaponDrawn"/>
    <Check kind="equippedType" hand="left" type="bow"/>
    <Or>
      <Check kind="attackState" state="bowAttached"/>
      <Check kind="attackState" state="bowDrawn"/>
    </Or>
    <True>
      <Check kind="sneaking"/>
      <True>
        <Row to="SneakBowDodge_B1">
          <Check kind="movementDirection" option="back"/>
        </Row>
        <Row to="SneakBowDodge_L1">
          <Check kind="movementDirection" option="left"/>
        </Row>
        <Row to="SneakBowDodge_R1">
          <Check kind="movementDirection" option="right"/>
        </Row>
      </True>
      <False>
        <Row to="BowDodge_B1">
          <Check kind="movementDirection" option="back"/>
        </Row>
        <Row to="BowDodge_L1">
          <Check kind="movementDirection" option="left"/>
        </Row>
        <Row to="BowDodge_R1">
          <Check kind="movementDirection" option="right"/>
        </Row>
      </False>
    </True>
  </Start>
  <Action id="BowDodge_B1" clip="Animations\DynamicDodgeShot\BowDodgeBack.hkx" firstPerson="switch">
    <Exit blend="0.3"/>
    <IFrame until="0.8"/>
    <MoveCancel at="1.647" blend="0.35"/>
    <EventValues>
      <Event name="DodgeShotFire">
        <Do op="fireArrow" mode="direct" damage="50"/>
      </Event>
    </EventValues>
  </Action>
  <Action id="BowDodge_L1" clip="Animations\DynamicDodgeShot\BowDodgeLeft.hkx" firstPerson="switch">
