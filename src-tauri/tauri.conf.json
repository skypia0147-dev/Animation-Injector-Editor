{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Animation Injector Editor",
  "version": "1.0.0",
  "identifier": "dev.smooth.animationinjectoreditor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Animation Injector Editor",
        "width": 1600,
        "height": 960,
        "minWidth": 1080,
        "minHeight": 700,
        "backgroundColor": "#111418"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
